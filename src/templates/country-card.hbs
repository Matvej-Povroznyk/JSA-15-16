<h2 class="country-title">{{name}}</h2>
<div class="country-card">
  <div class="country-info">
    <p class="country-info__capital"><span>Capital: </span>{{capital}}</p>
    <p class="country-info__population"><span>Population: </span>{{population}}</p>
    <p class="country-info__languages"><span>Languages: </span></p>
    <ul>
      {{#each languages}}
        <li>{{this.name}}</li>
      {{/each}}
    </ul>
  </div>
  <div class="country-flag">
    <img src="{{flag}}" alt="Flag of {{name}}" width="250" />
  </div>
</div>
